{
  "name": "sos-mendonca-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:poll": "nodemon --legacy-watch --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test src/db.test.ts src/auth.test.ts src/push.test.ts src/watchdog.test.ts src/ws.test.ts src/routes/device.test.ts src/routes/caregiver.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.19.0",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
