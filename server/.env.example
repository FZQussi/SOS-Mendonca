# Copia para .env e preenche. O .env nunca vai para o repositório.

PORT=3000

# Ficheiro SQLite. No Compose, ./server/data está bind-mounted a partir do host —
# o backup é copiar este ficheiro.
DB_PATH=data/sos.db

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sem contacto de um dispositivo durante este tempo → alerta device_offline.
# Não aumentes isto para "reduzir falsos positivos" (Context.md §8).
WATCHDOG_MINUTES=30

# Firebase Cloud Messaging — caminho para o JSON da service account
FCM_SERVICE_ACCOUNT=
